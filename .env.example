# BlueSky Account Credentials
# Replace these with your actual BlueSky app passwords

# State: NSW
BLUESKY_HANDLE_NSW=your-nsw-handle.bsky.social
BLUESKY_PASSWORD_NSW=your-nsw-app-password

# State: VIC
BLUESKY_HANDLE_VIC=your-vic-bot.bsky.social
BLUESKY_PASSWORD_VIC=xxxx-xxxx-xxxx-xxxx

# State: QLD
BLUESKY_HANDLE_QLD=your-qld-bot.bsky.social
BLUESKY_PASSWORD_QLD=xxxx-xxxx-xxxx-xxxx

# State: TAS
BLUESKY_HANDLE_TAS=your-tas-bot.bsky.social
BLUESKY_PASSWORD_TAS=xxxx-xxxx-xxxx-xxxx

# State: SA
BLUESKY_HANDLE_SA=your-sa-bot.bsky.social
BLUESKY_PASSWORD_SA=xxxx-xxxx-xxxx-xxxx

# State: WA
BLUESKY_HANDLE_WA=your-wa-bot.bsky.social
BLUESKY_PASSWORD_WA=xxxx-xxxx-xxxx-xxxx

# State: NT
BLUESKY_HANDLE_NT=your-nt-bot.bsky.social
BLUESKY_PASSWORD_NT=xxxx-xxxx-xxxx-xxxx

# State: ACT
BLUESKY_HANDLE_ACT=your-act-bot.bsky.social
BLUESKY_PASSWORD_ACT=xxxx-xxxx-xxxx-xxxx

# Optional: Proxy Configuration
# Standard HTTP Proxy
COUNCIL_BOT_PROXY=http://user:pass@host:port

# Rotating Proxy (for strict WAFs)
# Used by scrapers with "use_rotating_proxy": true
COUNCIL_BOT_ROTATING_PROXY=http://user:pass@host:port

# Optional: HTTP proxy for scraping
COUNCIL_BOT_PROXY=http://username:password@proxy.example.com:8080
COUNCIL_BOT_ROTATING_PROXY=http://username:password@rotating-proxy.example.com:8080

# Discord Logging Configuration
# Use different webhooks for feed vs system logs vs alerts (or the same one for all)
DISCORD_WEBHOOK_LOGS=https://discord.com/api/webhooks/xxxx/yyyy       # Daily Briefings & Run Summaries
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/xxxx/yyyy     # Critical Errors Only
DISCORD_WEBHOOK_FEED=https://discord.com/api/webhooks/xxxx/yyyy       # Public News Feed (Successes)

